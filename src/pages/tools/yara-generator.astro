---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Generador de Reglas YARA | Blue Team Hub" description="Crea y valida reglas de detección YARA paso a paso en tu navegador de forma sencilla con linter integrado.">
  <Header activeTab="herramientas" />

  <main class="w-full max-w-[1040px] mx-auto px-6 sm:px-7 pt-12 flex-grow">

    <!-- Breadcrumb & Header -->
    <div class="mb-10 pb-8 border-b border-rule-faint">
      <a href="/#herramientas" class="inline-flex items-center gap-1.5 font-mono text-xs text-muted hover:text-stamp transition-colors duration-150 mb-5 group">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform duration-200">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Volver a la caja de herramientas
      </a>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-2">
        Generador de Reglas YARA
      </h1>
      <p class="text-sm text-muted max-w-2xl">
        Construye reglas de detección YARA válidas a través de un formulario interactivo. Declara metadatos, añade cadenas (de texto, hexadecimales o expresiones regulares) con sus respectivos modificadores, define la condición y obtén el código validado por un analizador de sintaxis (linter) en tiempo real.
      </p>
    </div>

    <!-- Workspace -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16">

      <!-- Left Column: Form Builder (7 cols) -->
      <div class="lg:col-span-7 space-y-6">

        <!-- Template Selector Bar -->
        <div class="border border-rule-faint p-4 flex items-center justify-between gap-4">
          <span class="text-xs font-bold text-ink-soft font-mono flex items-center gap-2">
            Plantillas de Reglas YARA
          </span>
          <select
            id="templateSelect"
            class="bg-paper-dim border border-rule-faint focus:border-ink px-3 py-1.5 text-xs font-mono text-ink focus:outline-none cursor-pointer"
          >
            <option value="">Cargar Plantilla...</option>
            <option value="webshell">PHP Web Shell Detection</option>
            <option value="malware">Generic Ransomware Indicator</option>
            <option value="office">Office Malicious Macros</option>
            <option value="obfuscation">PowerShell Obfuscated Script</option>
          </select>
        </div>

        <!-- Box 1: Metadata -->
        <div class="border border-rule-faint p-6 space-y-4">
          <h2 class="text-xs font-bold tracking-wide uppercase font-mono border-b border-rule-faint pb-3 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-ink"></span>
            1. Metadatos de la Regla
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
              <label for="ruleName" class="text-xs text-muted font-medium">Nombre de la Regla *</label>
              <input
                type="text"
                id="ruleName"
                value="detect_threat_pattern"
                class="bg-paper-dim border border-rule-faint focus:border-ink px-3 py-2 text-xs font-mono text-ink focus:outline-none transition-colors duration-150"
                placeholder="ej: detect_malware_apt"
              />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="metaAuthor" class="text-xs text-muted font-medium">Autor</label>
              <input
                type="text"
                id="metaAuthor"
                value="Eduardo Olivares"
                class="bg-paper-dim border border-rule-faint focus:border-ink px-3 py-2 text-xs text-ink focus:outline-none transition-colors duration-150"
                placeholder="Tu nombre o empresa"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="flex flex-col gap-1.5">
              <label for="metaDesc" class="text-xs text-muted font-medium">Descripción</label>
              <input
                type="text"
                id="metaDesc"
                value="Detecta patrones sospechosos asociados a APT"
                class="bg-paper-dim border border-rule-faint focus:border-ink px-3 py-2 text-xs text-ink focus:outline-none transition-colors duration-150"
                placeholder="Descripción del incidente"
              />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="metaRef" class="text-xs text-muted font-medium">Referencia / CVE</label>
              <input
                type="text"
                id="metaRef"
                class="bg-paper-dim border border-rule-faint focus:border-ink px-3 py-2 text-xs text-ink focus:outline-none transition-colors duration-150"
                placeholder="ej: https://threatintel.com"
              />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="metaVersion" class="text-xs text-muted font-medium">Versión</label>
              <input
                type="text"
                id="metaVersion"
                value="1.0"
                class="bg-paper-dim border border-rule-faint focus:border-ink px-3 py-2 text-xs text-ink focus:outline-none transition-colors duration-150"
                placeholder="1.0"
              />
            </div>
          </div>
        </div>

        <!-- Box 2: Strings Section -->
        <div class="border border-rule-faint p-6 space-y-4">
          <div class="flex items-center justify-between border-b border-rule-faint pb-3">
            <h2 class="text-xs font-bold tracking-wide uppercase font-mono flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-ink"></span>
              2. Cadenas de Detección (Strings)
            </h2>
            <button
              id="btnAddString"
              class="px-2.5 py-1 border border-stamp text-stamp hover:bg-stamp-tint text-[10px] font-mono font-bold tracking-wider transition-colors duration-150 flex items-center gap-1 cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
              AÑADIR CADENA
            </button>
          </div>

          <!-- Dynamic Strings List -->
          <div id="stringsContainer" class="space-y-4">
            <!-- Default String Item (Initial) -->
            <div class="string-item bg-paper-dim border border-rule-faint p-4 space-y-3 relative group" data-id="1">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                  <span class="text-xs text-muted font-mono font-bold">$</span>
                  <input
                    type="text"
                    value="s1"
                    class="string-var w-20 bg-paper border border-rule-faint px-2 py-1 text-xs font-mono text-ink focus:outline-none focus:border-ink"
                    placeholder="s1"
                  />
                  <select
                    class="string-type bg-paper border border-rule-faint px-2 py-1 text-xs font-mono text-ink-soft focus:outline-none"
                  >
                    <option value="text">Texto</option>
                    <option value="hex">Hexadecimal</option>
                    <option value="regex">RegEx</option>
                  </select>
                </div>

                <!-- Remove Button (hidden on the only one) -->
                <button
                  class="btn-remove-string text-muted hover:text-stamp text-xs transition-colors duration-150 cursor-pointer p-1"
                >
                  Eliminar
                </button>
              </div>

              <!-- String Value Input -->
              <div class="flex flex-col gap-1">
                <input
                  type="text"
                  value="malicious_payload_domain"
                  class="string-val w-full bg-paper border border-rule-faint px-3 py-1.5 text-xs font-mono text-ink focus:outline-none focus:border-ink"
                  placeholder="ej: malicious_domain.com"
                />
              </div>

              <!-- Modifier Flags -->
              <div class="flex flex-wrap items-center gap-4 text-[10px] text-muted select-none string-flags">
                <label class="flex items-center gap-1.5 cursor-pointer hover:text-ink">
                  <input type="checkbox" checked class="flag-nocase accent-black" /> nocase
                </label>
                <label class="flex items-center gap-1.5 cursor-pointer hover:text-ink">
                  <input type="checkbox" class="flag-wide accent-black" /> wide
                </label>
                <label class="flex items-center gap-1.5 cursor-pointer hover:text-ink">
                  <input type="checkbox" checked class="flag-ascii accent-black" /> ascii
                </label>
                <label class="flex items-center gap-1.5 cursor-pointer hover:text-ink">
                  <input type="checkbox" class="flag-fullword accent-black" /> fullword
                </label>
                <label class="flex items-center gap-1.5 cursor-pointer hover:text-ink">
                  <input type="checkbox" class="flag-private accent-black" /> private
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Box 3: Condition Section -->
        <div class="border border-rule-faint p-6 space-y-4">
          <h2 class="text-xs font-bold tracking-wide uppercase font-mono border-b border-rule-faint pb-3 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-ink"></span>
            3. Condición de Disparo (Condition)
          </h2>

          <div class="flex flex-col gap-3">
            <label for="conditionStyle" class="text-xs text-muted font-medium">Lógica de Condición</label>
            <select
              id="conditionStyle"
              class="bg-paper-dim border border-rule-faint focus:border-ink px-3 py-2 text-xs font-mono text-ink focus:outline-none"
            >
              <option value="any">Cualquiera de las cadenas declaradas (any of them)</option>
              <option value="all">Todas las cadenas declaradas (all of them)</option>
              <option value="custom">Condición personalizada...</option>
            </select>
          </div>

          <!-- Custom Condition Input (shown only when 'custom' is selected) -->
          <div id="customConditionWrapper" class="flex flex-col gap-1.5 hidden">
            <label for="conditionCustom" class="text-xs text-muted font-medium">Condición Expresa</label>
            <input
              type="text"
              id="conditionCustom"
              value="any of ($s*)"
              class="bg-paper-dim border border-rule-faint focus:border-ink px-3 py-2 text-xs font-mono text-ink focus:outline-none transition-colors duration-150"
              placeholder="ej: $s1 and ($s2 or $s3)"
            />
          </div>
        </div>
      </div>

      <!-- Right Column: Live Output & Linter (5 cols) -->
      <div class="lg:col-span-5 space-y-6">

        <!-- YARA Rule Code Output -->
        <div class="border border-rule-faint p-6 flex flex-col justify-between relative min-h-[420px]">
          <div>
            <div class="flex items-center justify-between mb-4 border-b border-rule-faint pb-3">
              <h2 class="text-xs font-bold tracking-wide uppercase font-mono flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-ink"></span>
                Regla YARA Generada
              </h2>

              <div class="flex gap-2">
                <button
                  id="btnDownloadYar"
                  class="px-3 py-1.5 border border-rule-faint hover:border-ink text-ink-soft hover:text-ink text-[11px] font-semibold transition-colors duration-150 flex items-center gap-1.5 cursor-pointer"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                  </svg>
                  Descargar .yar
                </button>

                <button
                  id="btnCopy"
                  class="px-3 py-1.5 border border-rule-faint hover:border-ink text-ink-soft hover:text-ink text-[11px] font-semibold transition-colors duration-150 flex items-center gap-1.5 cursor-pointer"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H5.25m11.9-3.664A2.251 2.251 0 0 0 15 2.25h-1.5a2.251 2.251 0 0 0-2.15 1.586m5.8 0c.065.21.1.433.1.664v.75h-6V4.5c0-.231.035-.454.1-.664M6.75 7.375c0-.621.504-1.125 1.125-1.125h9.75c.621 0 1.125.504 1.125 1.125v.375m-12 10.5V7.375m12 10.5V11.25M18 10.5h.008v.008H18V10.5Zm-3-3h.008v.008H15V7.5Z" />
                  </svg>
                  Copiar
                </button>
              </div>
            </div>

            <!-- Code display area -->
            <pre class="w-full bg-paper-dim border border-rule-faint p-4 text-xs font-mono text-ink-soft overflow-x-auto min-h-[300px] whitespace-pre select-all" id="yaraOutput"></pre>
          </div>
        </div>

        <!-- YARA Sandbox Tester (Local) -->
        <div class="border border-rule-faint p-6 space-y-4">
          <div class="flex items-center justify-between border-b border-rule-faint pb-3">
            <h3 class="text-xs font-bold tracking-wider uppercase font-mono flex items-center gap-2.5">
              YARA Sandbox Tester (Local)
            </h3>
            <span id="sandboxStatus" class="px-2 py-0.5 text-[10px] font-mono font-bold border border-rule-faint text-muted uppercase tracking-wider">No evaluado</span>
          </div>

          <textarea
            id="sandboxInput"
            rows="5"
            class="w-full bg-paper-dim border border-rule-faint focus:border-ink p-3 text-xs font-mono text-ink placeholder-muted-dim focus:outline-none transition-colors duration-150 resize-y"
            placeholder="Pega aquí el contenido de un archivo o cadena sospechosa para comprobar coincidencias de tu regla en tiempo real..."
          ></textarea>

          <div id="sandboxMatches" class="text-[11px] font-mono text-muted space-y-1">
            Ninguna coincidencia activa.
          </div>
        </div>

        <!-- Linter (Syntax Validation) -->
        <div class="border border-rule-faint p-6">
          <h3 class="text-xs font-bold tracking-wider uppercase font-mono mb-4 flex items-center gap-2.5 border-b border-rule-faint pb-2.5">
            Analizador de Sintaxis (Linter)
          </h3>

          <div class="space-y-3" id="linterList">
            <!-- Warnings and errors will be populated dynamically -->
          </div>
        </div>

      </div>

    </div>

  </main>

  <Footer />
</Layout>

<script>
  // UI Elements
  const ruleName = document.getElementById('ruleName') as HTMLInputElement;
  const metaAuthor = document.getElementById('metaAuthor') as HTMLInputElement;
  const metaDesc = document.getElementById('metaDesc') as HTMLInputElement;
  const metaRef = document.getElementById('metaRef') as HTMLInputElement;
  const metaVersion = document.getElementById('metaVersion') as HTMLInputElement;

  const stringsContainer = document.getElementById('stringsContainer') as HTMLDivElement;
  const btnAddString = document.getElementById('btnAddString') as HTMLButtonElement;

  const conditionStyle = document.getElementById('conditionStyle') as HTMLSelectElement;
  const customConditionWrapper = document.getElementById('customConditionWrapper') as HTMLDivElement;
  const conditionCustom = document.getElementById('conditionCustom') as HTMLInputElement;

  const yaraOutput = document.getElementById('yaraOutput') as HTMLPreElement;
  const btnCopy = document.getElementById('btnCopy') as HTMLButtonElement;
  const btnDownloadYar = document.getElementById('btnDownloadYar') as HTMLButtonElement;
  const linterList = document.getElementById('linterList') as HTMLDivElement;

  const templateSelect = document.getElementById('templateSelect') as HTMLSelectElement;
  const sandboxInput = document.getElementById('sandboxInput') as HTMLTextAreaElement;
  const sandboxStatus = document.getElementById('sandboxStatus') as HTMLElement;
  const sandboxMatches = document.getElementById('sandboxMatches') as HTMLElement;

  let stringIdCounter = 1;

  // Track event listeners in strings to update output
  function bindStringEvents(el: HTMLElement) {
    const inputs = el.querySelectorAll('input, select');
    inputs.forEach(input => {
      input.addEventListener('input', generateRule);
    });

    const typeSelect = el.querySelector('.string-type') as HTMLSelectElement;
    typeSelect.addEventListener('change', () => {
      const selected = typeSelect.value;
      const flagsDiv = el.querySelector('.string-flags') as HTMLDivElement;
      const valInput = el.querySelector('.string-val') as HTMLInputElement;

      // Update placeholder based on type
      if (selected === 'hex') {
        valInput.placeholder = 'ej: { E2 34 ?? 5F 88 }';
        if (valInput.value === 'malicious_payload_domain') {
          valInput.value = '{ E2 34 ?? 5F 88 }';
        }
        flagsDiv.classList.add('opacity-30', 'pointer-events-none');
      } else if (selected === 'regex') {
        valInput.placeholder = 'ej: /malicious\\.[a-z]{2,4}/';
        flagsDiv.classList.remove('opacity-30', 'pointer-events-none');
      } else {
        valInput.placeholder = 'ej: malicious_domain.com';
        flagsDiv.classList.remove('opacity-30', 'pointer-events-none');
      }
      generateRule();
    });

    const btnRemove = el.querySelector('.btn-remove-string') as HTMLButtonElement;
    btnRemove.addEventListener('click', () => {
      const items = stringsContainer.querySelectorAll('.string-item');
      if (items.length > 1) {
        el.remove();
        generateRule();
      } else {
        alert('Debes tener al menos una cadena declarada en la regla YARA.');
      }
    });
  }

  // Initialize first string item events
  bindStringEvents(stringsContainer.firstElementChild as HTMLElement);

  // Add String Button Click
  btnAddString.addEventListener('click', () => {
    stringIdCounter++;
    const template = stringsContainer.firstElementChild as HTMLElement;
    const clone = template.cloneNode(true) as HTMLElement;

    // Set unique values
    clone.dataset.id = stringIdCounter.toString();
    const varInput = clone.querySelector('.string-var') as HTMLInputElement;
    varInput.value = `s${stringIdCounter}`;

    const valInput = clone.querySelector('.string-val') as HTMLInputElement;
    valInput.value = '';
    valInput.placeholder = 'ej: malicious_pattern';

    // Bind change events
    bindStringEvents(clone);
    stringsContainer.appendChild(clone);
    generateRule();
  });

  function addString(variable: string, type: 'text'|'hex'|'regex', value: string, flags: { nocase?: boolean; wide?: boolean; ascii?: boolean; fullword?: boolean; private?: boolean } = {}) {
    const template = stringsContainer.firstElementChild as HTMLElement;
    let clone;
    if (stringsContainer.children.length === 1 && (stringsContainer.firstElementChild as HTMLElement).querySelector('.string-val')?.getAttribute('value') === 'malicious_payload_domain') {
      clone = template;
    } else {
      clone = template.cloneNode(true) as HTMLElement;
    }

    clone.dataset.id = String(++stringIdCounter);
    (clone.querySelector('.string-var') as HTMLInputElement).value = variable;
    (clone.querySelector('.string-type') as HTMLSelectElement).value = type;

    const valInput = clone.querySelector('.string-val') as HTMLInputElement;
    valInput.value = value;
    valInput.setAttribute('value', value);

    const flagNocase = clone.querySelector('.flag-nocase') as HTMLInputElement;
    const flagWide = clone.querySelector('.flag-wide') as HTMLInputElement;
    const flagAscii = clone.querySelector('.flag-ascii') as HTMLInputElement;
    const flagFullword = clone.querySelector('.flag-fullword') as HTMLInputElement;
    const flagPrivate = clone.querySelector('.flag-private') as HTMLInputElement;

    flagNocase.checked = !!flags.nocase;
    flagWide.checked = !!flags.wide;
    flagAscii.checked = !!flags.ascii;
    flagFullword.checked = !!flags.fullword;
    flagPrivate.checked = !!flags.private;

    const flagsDiv = clone.querySelector('.string-flags') as HTMLElement;
    if (type === 'hex') {
      flagsDiv.classList.add('opacity-30', 'pointer-events-none');
    } else {
      flagsDiv.classList.remove('opacity-30', 'pointer-events-none');
    }

    if (clone !== template) {
      bindStringEvents(clone);
      stringsContainer.appendChild(clone);
    } else {
      bindStringEvents(clone);
    }
  }

  // Template select trigger
  templateSelect.addEventListener('change', () => {
    const val = templateSelect.value;
    if (!val) return;

    if (val === 'webshell') {
      ruleName.value = 'detect_php_webshell';
      metaDesc.value = 'PHP web shell detection template';
      metaAuthor.value = 'SOC Enterprise';
      metaVersion.value = '1.0';
      metaRef.value = 'https://github.com/tennc/webshell';
      conditionStyle.value = 'any';
      customConditionWrapper.classList.add('hidden');

      stringsContainer.innerHTML = '';
      stringIdCounter = 0;
      addString('s1', 'text', 'eval(base64_decode', { nocase: true });
      addString('s2', 'text', 'system($_GET', { nocase: true });
      addString('s3', 'regex', 'shell_exec\\s*\\(\\s*\\$_POST', { nocase: true });
    } else if (val === 'malware') {
      ruleName.value = 'detect_ransomware_generic';
      metaDesc.value = 'Generic ransomware indicator strings';
      metaAuthor.value = 'ThreatIntel Pro';
      metaVersion.value = '1.1';
      metaRef.value = 'CVE-2026-9999';
      conditionStyle.value = 'any';
      customConditionWrapper.classList.add('hidden');

      stringsContainer.innerHTML = '';
      stringIdCounter = 0;
      addString('s1', 'text', '.locked', { nocase: true });
      addString('s2', 'text', 'YOUR_FILES_ARE_ENCRYPTED', { nocase: true });
      addString('s3', 'hex', '70 68 61 72 61 6f 68', {});
    } else if (val === 'office') {
      ruleName.value = 'office_malicious_macro';
      metaDesc.value = 'Detects suspicious VBA macros in documents';
      metaAuthor.value = 'SOC Pro';
      metaVersion.value = '1.0';
      metaRef.value = '';
      conditionStyle.value = 'any';
      customConditionWrapper.classList.add('hidden');

      stringsContainer.innerHTML = '';
      stringIdCounter = 0;
      addString('s1', 'text', 'Document_Open', { nocase: true, ascii: true });
      addString('s2', 'text', 'AutoOpen', { nocase: true, ascii: true });
      addString('s3', 'text', 'ShellExecute', { nocase: true, ascii: true });
      addString('s4', 'text', 'WScript.Shell', { nocase: true, ascii: true });
    } else if (val === 'obfuscation') {
      ruleName.value = 'powershell_obfuscated_command';
      metaDesc.value = 'Detects obfuscated PowerShell download cradles';
      metaAuthor.value = 'APT Hunter';
      metaVersion.value = '2.0';
      metaRef.value = '';
      conditionStyle.value = 'any';
      customConditionWrapper.classList.add('hidden');

      stringsContainer.innerHTML = '';
      stringIdCounter = 0;
      addString('s1', 'text', 'Net.WebClient', { nocase: true, wide: true, ascii: true });
      addString('s2', 'text', 'DownloadString', { nocase: true, wide: true, ascii: true });
      addString('s3', 'text', 'IEX', { nocase: true, wide: true, ascii: true });
      addString('s4', 'text', 'Invoke-Expression', { nocase: true, wide: true, ascii: true });
    }

    generateRule();
  });

  // Condition dropdown
  conditionStyle.addEventListener('change', () => {
    if (conditionStyle.value === 'custom') {
      customConditionWrapper.classList.remove('hidden');
    } else {
      customConditionWrapper.classList.add('hidden');
    }
    generateRule();
  });

  // Base Form events
  [ruleName, metaAuthor, metaDesc, metaRef, metaVersion, conditionCustom].forEach(el => {
    el.addEventListener('input', generateRule);
  });

  // Core formatting & linting engine
  interface YaraString {
    variable: string;
    type: 'text' | 'hex' | 'regex';
    value: string;
    nocase: boolean;
    wide: boolean;
    ascii: boolean;
    fullword: boolean;
    private: boolean;
  }

  function getStrings(): YaraString[] {
    const list: YaraString[] = [];
    const items = stringsContainer.querySelectorAll('.string-item');
    items.forEach((item) => {
      const el = item as HTMLElement;
      const variable = (el.querySelector('.string-var') as HTMLInputElement).value.trim();
      const type = (el.querySelector('.string-type') as HTMLSelectElement).value as any;
      const value = (el.querySelector('.string-val') as HTMLInputElement).value.trim();

      const nocase = (el.querySelector('.flag-nocase') as HTMLInputElement).checked;
      const wide = (el.querySelector('.flag-wide') as HTMLInputElement).checked;
      const ascii = (el.querySelector('.flag-ascii') as HTMLInputElement).checked;
      const fullword = (el.querySelector('.flag-fullword') as HTMLInputElement).checked;
      const privateFlag = (el.querySelector('.flag-private') as HTMLInputElement).checked;

      list.push({
        variable,
        type,
        value,
        nocase,
        wide,
        ascii,
        fullword,
        private: privateFlag
      });
    });
    return list;
  }

  function generateRule() {
    const name = ruleName.value.trim().replace(/\s+/g, '_');
    const author = metaAuthor.value.trim();
    const description = metaDesc.value.trim();
    const reference = metaRef.value.trim();
    const version = metaVersion.value.trim();

    const stringsList = getStrings();
    const condStyle = conditionStyle.value;
    const condCustom = conditionCustom.value.trim();

    // 1. Build Rule Header
    let ruleText = `rule ${name || 'detect_unnamed_rule'}\n{\n`;

    // 2. Build Meta Section
    if (description || author || reference || version) {
      ruleText += `    meta:\n`;
      if (description) ruleText += `        description = "${description}"\n`;
      if (author) ruleText += `        author = "${author}"\n`;
      if (reference) ruleText += `        reference = "${reference}"\n`;
      if (version) ruleText += `        version = "${version}"\n`;
      ruleText += `        date = "${new Date().toISOString().split('T')[0]}"\n`;
    }

    // 3. Build Strings Section
    if (stringsList.length > 0) {
      ruleText += `\n    strings:\n`;
      stringsList.forEach((str) => {
        if (!str.variable) return;

        let line = `        $${str.variable} = `;
        if (str.type === 'hex') {
          // Hex string value format: { AB CD 12 }
          let val = str.value;
          if (!val.startsWith('{')) val = `{ ${val}`;
          if (!val.endsWith('}')) val = `${val} }`;
          line += val;
        } else if (str.type === 'regex') {
          // Regex value format: /abc/
          let val = str.value;
          if (!val.startsWith('/')) val = `/${val}`;
          if (!val.endsWith('/')) val = `${val}/`;
          line += val;
        } else {
          // Text format
          line += `"${str.value}"`;
        }

        // Modifiers flags (only for text and regex)
        if (str.type !== 'hex') {
          const modifiers = [];
          if (str.nocase) modifiers.push('nocase');
          if (str.wide) modifiers.push('wide');
          if (str.ascii) modifiers.push('ascii');
          if (str.fullword) modifiers.push('fullword');
          if (str.private) modifiers.push('private');

          if (modifiers.length > 0) {
            line += ` ${modifiers.join(' ')}`;
          }
        }

        ruleText += `${line}\n`;
      });
    }

    // 4. Build Condition Section
    ruleText += `\n    condition:\n`;
    if (condStyle === 'any') {
      ruleText += `        any of them\n`;
    } else if (condStyle === 'all') {
      ruleText += `        all of them\n`;
    } else {
      ruleText += `        ${condCustom || 'any of them'}\n`;
    }

    ruleText += `}`;

    yaraOutput.textContent = ruleText;

    // Run lint checks
    runLinter(name, stringsList, condStyle, condCustom);
    // Run sandbox execution
    runSandbox();
  }

  // Syntax Linter Logic
  interface LintItem {
    type: 'error' | 'warning' | 'success';
    message: string;
  }

  function runLinter(name: string, strings: YaraString[], condStyle: string, condCustom: string) {
    const list: LintItem[] = [];

    // Check 1: Rule Name
    const nameRegex = /^[a-zA-Z_][a-zA-Z0-9_]*$/;
    if (!name) {
      list.push({ type: 'error', message: 'El nombre de la regla no puede estar vacío.' });
    } else if (!nameRegex.test(name)) {
      list.push({ type: 'error', message: 'El nombre de la regla contiene caracteres no válidos. Debe empezar por letra o guion bajo (_) y no contener espacios ni caracteres especiales.' });
    }

    // Check 2: Strings variables syntax and duplicates
    const declaredVariables = new Set<string>();
    let duplicates = false;
    strings.forEach(str => {
      if (!str.variable) return;
      if (declaredVariables.has(str.variable)) {
        duplicates = true;
      }
      declaredVariables.add(str.variable);

      // Check hex string syntax
      if (str.type === 'hex' && str.value) {
        const clean = str.value.replace(/[{}]/g, '').trim();
        // Regex to check valid hex pattern: only hex numbers, double questions ?? or spacing
        const hexRegex = /^[a-fA-F0-9\?\s]+$/;
        if (!hexRegex.test(clean)) {
          list.push({ type: 'warning', message: `La cadena hexadecimal $${str.variable} contiene caracteres no válidos (solo se permite 0-9, A-F y ??).` });
        }
      }
    });

    if (duplicates) {
      list.push({ type: 'error', message: 'Hay variables de cadenas duplicadas en la declaración.' });
    }

    // Check 3: Variables declared vs referenced in custom conditions
    if (condStyle === 'custom' && condCustom) {
      // Find all referenced variables ($s1, etc.)
      const variableRegex = /\$[a-zA-Z0-9_]+/g;
      const referencedMatches = condCustom.match(variableRegex) || [];
      const referencedVariables = new Set(referencedMatches.map(m => m.substring(1))); // strip leading $

      // 3.1. Undeclared variable used in condition
      referencedVariables.forEach(ref => {
        // Handle wildcards like $s* by matching prefixes
        if (ref.endsWith('*')) {
          const prefix = ref.slice(0, -1);
          let found = false;
          declaredVariables.forEach(dec => {
            if (dec.startsWith(prefix)) found = true;
          });
          if (!found) {
            list.push({ type: 'error', message: `La condición usa el patrón de comodín $${ref}, pero no hay variables declaradas que empiecen por '${prefix}'.` });
          }
        } else {
          if (!declaredVariables.has(ref)) {
            list.push({ type: 'error', message: `La variable $${ref} se usa en la condición pero no ha sido declarada en la sección 'strings'.` });
          }
        }
      });

      // 3.2. Declared variable unused in condition
      declaredVariables.forEach(dec => {
        let isUsed = referencedVariables.has(dec);
        // Check if matches wildcard like $s*
        referencedVariables.forEach(ref => {
          if (ref.endsWith('*')) {
            const prefix = ref.slice(0, -1);
            if (dec.startsWith(prefix)) {
              isUsed = true;
            }
          }
        });
        if (!isUsed) {
          list.push({ type: 'warning', message: `La cadena $${dec} está declarada pero no se hace referencia a ella en la condición.` });
        }
      });
    }

    // Render linter output
    linterList.innerHTML = '';

    if (list.length === 0) {
      const itemDiv = document.createElement('div');
      itemDiv.className = 'flex items-start gap-2.5 text-xs text-online font-medium border border-online p-3';
      itemDiv.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 shrink-0 text-online">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
        <span>Regla YARA válida. Cero errores de sintaxis o variables no utilizadas.</span>
      `;
      linterList.appendChild(itemDiv);
    } else {
      list.forEach((item) => {
        const itemDiv = document.createElement('div');
        if (item.type === 'error') {
          itemDiv.className = 'flex items-start gap-2.5 text-xs text-stamp bg-stamp-tint border border-stamp p-3';
          itemDiv.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 shrink-0 text-stamp">
              <path stroke-linecap="round" stroke-linejoin="round" d="m9.75 9.75 4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            <span><strong>[Error]</strong> ${item.message}</span>
          `;
        } else {
          itemDiv.className = 'flex items-start gap-2.5 text-xs text-ink-soft border border-rule-faint p-3';
          itemDiv.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 shrink-0 text-ink-soft">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
            </svg>
            <span><strong>[Advertencia]</strong> ${item.message}</span>
          `;
        }
        linterList.appendChild(itemDiv);
      });
    }
  }

  // Copy to clipboard with animation
  btnCopy.addEventListener('click', () => {
    const text = yaraOutput.textContent;
    if (!text) return;

    navigator.clipboard.writeText(text).then(() => {
      const originalHtml = btnCopy.innerHTML;
      btnCopy.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 text-online">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
        <span class="text-online">Copiado!</span>
      `;
      btnCopy.classList.add('border-online');

      setTimeout(() => {
        btnCopy.innerHTML = originalHtml;
        btnCopy.classList.remove('border-online');
      }, 2000);
    });
  });

  // Sandbox Evaluation Engine
  function runSandbox() {
    if (!sandboxInput) return;
    const sampleText = sandboxInput.value;
    if (!sampleText) {
      sandboxStatus.textContent = "No evaluado";
      sandboxStatus.className = "px-2 py-0.5 text-[10px] font-mono font-bold border border-rule-faint text-muted uppercase tracking-wider";
      sandboxMatches.innerHTML = "Ninguna coincidencia activa.";
      return;
    }

    const stringsList = getStrings();
    const matches: string[] = [];

    stringsList.forEach(str => {
      if (!str.variable || !str.value) return;

      let matched = false;
      if (str.type === 'text') {
        const valToSearch = str.nocase ? sampleText.toLowerCase() : sampleText;
        const textToSearch = str.nocase ? str.value.toLowerCase() : str.value;
        if (valToSearch.includes(textToSearch)) {
          matched = true;
        }
      } else if (str.type === 'regex') {
        try {
          let cleanVal = str.value;
          if (cleanVal.startsWith('/')) cleanVal = cleanVal.slice(1);
          if (cleanVal.endsWith('/')) cleanVal = cleanVal.slice(0, -1);

          const flags = str.nocase ? 'i' : '';
          const rx = new RegExp(cleanVal, flags);
          if (rx.test(sampleText)) {
            matched = true;
          }
        } catch(e) {
          // Ignore regex compile error in tests
        }
      } else if (str.type === 'hex') {
        const cleanHex = str.value.replace(/[{}]/g, '').replace(/\?/g, '').replace(/\s+/g, '').toLowerCase();
        if (cleanHex) {
          const sampleHex = Array.from(sampleText).map(c => c.charCodeAt(0).toString(16).padStart(2, '0')).join('');
          if (sampleHex.includes(cleanHex) || sampleText.toLowerCase().includes(cleanHex)) {
            matched = true;
          }
        }
      }

      if (matched) {
        matches.push(str.variable);
      }
    });

    const condStyle = conditionStyle.value;
    let ruleMatched = false;

    if (condStyle === 'any') {
      ruleMatched = matches.length > 0;
    } else if (condStyle === 'all') {
      ruleMatched = matches.length === stringsList.length && stringsList.length > 0;
    } else {
      let expr = conditionCustom.value.trim().toLowerCase();
      expr = expr.replace(/\band\b/g, '&&').replace(/\bor\b/g, '||').replace(/\bnot\b/g, '!');

      stringsList.forEach(str => {
        const isMatched = matches.includes(str.variable);
        const rx = new RegExp(`\\$${str.variable}\\b`, 'g');
        expr = expr.replace(rx, String(isMatched));
      });

      if (expr.includes('any of ($')) {
        ruleMatched = matches.length > 0;
      } else if (expr.includes('all of ($')) {
        ruleMatched = matches.length === stringsList.length && stringsList.length > 0;
      } else {
        try {
          const fn = new Function(`return (${expr});`);
          ruleMatched = !!fn();
        } catch(e) {
          ruleMatched = matches.length > 0;
        }
      }
    }

    if (ruleMatched) {
      sandboxStatus.textContent = "COINCIDENCIA ENCONTRADA";
      sandboxStatus.className = "px-2 py-0.5 text-[10px] font-mono font-bold border border-online text-online uppercase tracking-wider";
    } else {
      sandboxStatus.textContent = "SIN COINCIDENCIA";
      sandboxStatus.className = "px-2 py-0.5 text-[10px] font-mono font-bold border border-stamp text-stamp bg-stamp-tint uppercase tracking-wider";
    }

    if (matches.length > 0) {
      sandboxMatches.innerHTML = `<strong>Coincidencias (${matches.length}/${stringsList.length}):</strong> ` +
        matches.map(m => `<span class="text-ink font-bold">$${m}</span>`).join(', ');
    } else {
      sandboxMatches.textContent = "Ninguna coincidencia activa de variables.";
    }
  }

  // Sandbox listeners
  sandboxInput.addEventListener('input', runSandbox);

  // Download rule as file
  btnDownloadYar.addEventListener('click', () => {
    const code = yaraOutput.textContent;
    if (!code) return;
    const name = ruleName.value.trim().replace(/\s+/g, '_') || 'yara_rule';
    const blob = new Blob([code], { type: "text/plain;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${name}.yar`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  // Initial generation on load
  generateRule();
</script>

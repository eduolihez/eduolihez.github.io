---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';
import kevData from '../data/kev.json';

// Tools catalog. `group` drives which homepage section a card renders in:
// "site" = built into Blue Team Hub (client-side, this repo). "external" =
// lives elsewhere (another repo, the portfolio site), just linked from here.
// kev-watch has no href of its own anymore: it's rendered inline in section
// 02 below instead of living behind a separate route.
const tools = [
  {
    id: "defanger",
    title: "IOC Defanger & Extractor",
    description: "Desarma (defang) e higieniza de forma segura direcciones IP, URLs y correos electrónicos para tus informes, o extrae IOCs directamente desde texto crudo en segundos.",
    badge: "DISPONIBLE",
    badgeColor: "",
    href: "/tools/defanger",
    actionText: "Abrir Herramienta",
    disabled: false,
    group: "site",
  },
  {
    id: "email-analyzer",
    title: "Email Header Analyzer",
    description: "Analiza cabeceras crudas de correos sospechosos o ficheros .eml de forma visual. Comprueba la autenticación SPF, DKIM, DMARC y representa los saltos de red.",
    badge: "DISPONIBLE",
    badgeColor: "",
    href: "/tools/email-analyzer",
    actionText: "Abrir Herramienta",
    disabled: false,
    group: "site",
  },
  {
    id: "yara-generator",
    title: "Generador de Reglas YARA",
    description: "Escribe y valida reglas de detección YARA sin errores de sintaxis a través de un asistente paso a paso con analizador (linter) integrado en tiempo real.",
    badge: "DISPONIBLE",
    badgeColor: "",
    href: "/tools/yara-generator",
    actionText: "Abrir Herramienta",
    disabled: false,
    group: "site",
  },
  {
    id: "playbooks",
    title: "Playbooks Interactivos",
    description: "Árboles de decisión interactivos para diagnosticar incidentes de seguridad (Phishing, Malware, Fuerza Bruta) con recomendaciones y consultas SIEM automáticas.",
    badge: "DISPONIBLE",
    badgeColor: "",
    href: "/tools/playbooks",
    actionText: "Abrir Herramienta",
    disabled: false,
    group: "site",
  },
  {
    id: "decoder",
    title: "Payload Decoder & Deobfuscator",
    description: "Decodifica Base64 (UTF-8/UTF-16LE), URL, Hex y desofusca scripts de PowerShell limpiando concatenaciones y backticks de forma local.",
    badge: "DISPONIBLE",
    badgeColor: "",
    href: "/tools/decoder",
    actionText: "Abrir Herramienta",
    disabled: false,
    group: "site",
  },
  {
    id: "osint-hub",
    title: "OSINT Hub & Enlaces Externos",
    description: "Genera consultas rápidas OSINT extrayendo y vinculando IPs, dominios y hashes a motores externos (VirusTotal, AbuseIPDB) con directorio de recursos.",
    badge: "DISPONIBLE",
    badgeColor: "",
    href: "/tools/osint-hub",
    actionText: "Abrir Herramienta",
    disabled: false,
    group: "site",
  },
  {
    id: "kev-watch",
    title: "KEV Watch",
    description: "Vigilancia automatizada (GitHub Actions) del catálogo CISA KEV: vulnerabilidades con explotación activa confirmada, integrada aquí mismo, sin salir de la página.",
    badge: "AUTOMATIZADO",
    badgeColor: "",
    href: "#kev-watch",
    actionText: "Ver aquí abajo",
    disabled: false,
    group: "site",
  },
  {
    id: "passwdcentinel",
    title: "Password Sentinel",
    description: "Visita el proyecto oficial de tu extensión de Chrome para auditar contraseñas y verificar filtraciones vía API de Have I Been Pwned.",
    badge: "EXTENSIÓN CHROME",
    badgeColor: "",
    href: "https://eduolihez.com/projects/passwdcentinel/",
    actionText: "Ir a eduolihez.com",
    disabled: false,
    external: true,
    group: "site",
  },
  {
    id: "followguard",
    title: "FollowGuard OSINT",
    description: "Visualiza el desarrollo de tu herramienta de ciberinteligencia en redes sociales para detectar perfiles falsos y bots.",
    badge: "EN DESARROLLO",
    badgeColor: "",
    href: "https://eduolihez.com/projects/followguard/",
    actionText: "Ir a eduolihez.com",
    disabled: false,
    external: true,
    group: "site",
  }
];

const siteTools = tools.filter((t) => t.group === "site");

// KEV Watch data — same source and logic as the (now retired) standalone
// /tools/kev-watch page, rendered inline instead of behind a route.
const { lastUpdated, totalTracked, recentAdditions } = kevData;
const ransomwareRecent = recentAdditions.filter((v: any) => v.knownRansomware).length;

const formatDate = (d: string) =>
  new Date(d + 'T00:00:00Z').toLocaleDateString('es-ES', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  });

const isOverdue = (dueDate: string | null) =>
  !!dueDate && new Date(dueDate + 'T00:00:00Z').getTime() < Date.now();
---

<Layout title="Blue Team Hub | Eduardo Olivares" description="Portal de herramientas estáticas de ciberseguridad para analistas SOC y respuesta a incidentes.">
  <Header activeTab="inicio" />

  <main class="w-full flex-grow">

    <!-- Masthead -->
    <section class="max-w-[1040px] mx-auto px-6 sm:px-7 pt-16 pb-12 border-b-2 border-ink">
      <div class="flex items-center justify-between gap-4 font-mono text-[11px] sm:text-xs uppercase tracking-wide text-muted mb-7">
        <span>Blue Team Hub <span class="text-stamp">·</span> Portal de herramientas SOC</span>
        <span class="hidden sm:inline">eduolihez.github.io</span>
      </div>

      <h1 class="trace font-extrabold tracking-tight leading-[0.98] mb-5 max-w-[15ch]" style="font-size:clamp(2.5rem, 6.2vw, 4.6rem);">
        Herramientas para operar, <span class="text-stamp">no para hojear.</span>
      </h1>

      <p class="text-lg text-ink-soft max-w-[54ch] mb-6">
        Utilidades 100% del lado del cliente para analistas SOC y threat hunters. Nada de lo que pegues aquí sale de tu navegador.
      </p>

      <p class="font-mono text-xs text-muted">
        Por <strong class="text-ink font-semibold">Eduardo Olivares</strong> — complemento de <a href="https://eduolihez.com" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-stamp">eduolihez.com</a>
      </p>
    </section>

    <!-- Stat strip -->
    <section class="max-w-[1040px] mx-auto grid grid-cols-3 border-b-2 border-ink">
      <div class="px-6 sm:px-7 py-6 border-r border-rule-faint">
        <div class="font-mono font-semibold text-ink" style="font-size:clamp(1.6rem, 3.4vw, 2.4rem);">{totalTracked.toLocaleString('es-ES')}</div>
        <div class="text-sm text-muted mt-2">CVEs en seguimiento</div>
      </div>
      <div class="px-6 sm:px-7 py-6 border-r border-rule-faint">
        <div class="font-mono font-semibold text-stamp" style="font-size:clamp(1.6rem, 3.4vw, 2.4rem);">{recentAdditions.length}</div>
        <div class="text-sm text-muted mt-2">nuevas en los últimos 45 días</div>
      </div>
      <div class="px-6 sm:px-7 py-6">
        <div class="font-mono font-semibold text-ink" style="font-size:clamp(1.6rem, 3.4vw, 2.4rem);">{formatDate(lastUpdated)}</div>
        <div class="text-sm text-muted mt-2">última comprobación del catálogo CISA</div>
      </div>
    </section>

    <!-- 01 — Herramientas -->
    <section id="herramientas" class="max-w-[1040px] mx-auto px-6 sm:px-7 py-14 border-b border-rule-faint scroll-mt-20">
      <div class="flex items-baseline gap-4 mb-2">
        <span class="font-mono text-sm text-stamp">01</span>
        <h2 class="text-2xl font-bold">Herramientas</h2>
      </div>
      <p class="text-sm text-muted max-w-[62ch] mb-8">
        Siete utilidades del lado del cliente, más dos proyectos hermanos alojados en eduolihez.com. KEV Watch vive aquí mismo, no detrás de un enlace.
      </p>

      <ul class="border-t border-rule-faint list-none m-0 p-0">
        {siteTools.map((tool, i) => <ToolCard tool={tool} index={i + 1} />)}
      </ul>
    </section>

    <!-- 02 — KEV Watch (embedded, not a separate app) -->
    <section id="kev-watch" class="max-w-[1040px] mx-auto px-6 sm:px-7 py-14 border-b border-rule-faint scroll-mt-20">
      <div class="flex items-baseline gap-4 mb-2">
        <span class="font-mono text-sm text-stamp">02</span>
        <h2 class="text-2xl font-bold">KEV Watch</h2>
      </div>
      <p class="text-sm text-muted max-w-[64ch] mb-8">
        Vigilancia automatizada del catálogo <a href="https://www.cisa.gov/known-exploited-vulnerabilities-catalog" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-stamp">CISA KEV</a>: vulnerabilidades con explotación activa confirmada, no CVEs teóricos. Un <a href="https://github.com/eduolihez/eduolihez.github.io/blob/main/.github/workflows/kev-watch.yml" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-stamp">GitHub Action</a> descarga el catálogo, calcula qué ha cambiado y redespliega esta misma página — sin intervención manual.
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-4 border-t border-b border-ink mb-6">
        <div class="py-3.5 pr-3 border-r border-rule-faint">
          <div class="font-mono font-semibold text-lg">{totalTracked.toLocaleString('es-ES')}</div>
          <div class="text-[11px] uppercase tracking-wide text-muted mt-1">Tracked</div>
        </div>
        <div class="py-3.5 px-3 border-r border-rule-faint sm:border-r">
          <div class="font-mono font-semibold text-lg text-stamp">{ransomwareRecent}</div>
          <div class="text-[11px] uppercase tracking-wide text-muted mt-1">Ransomware (45d)</div>
        </div>
        <div class="py-3.5 px-3 border-r border-rule-faint">
          <div class="font-mono font-semibold text-lg">{recentAdditions.length}</div>
          <div class="text-[11px] uppercase tracking-wide text-muted mt-1">Nuevas (45d)</div>
        </div>
        <div class="py-3.5 pl-3">
          <div class="font-mono font-semibold text-lg">{formatDate(lastUpdated)}</div>
          <div class="text-[11px] uppercase tracking-wide text-muted mt-1">Última pasada</div>
        </div>
      </div>

      <input
        id="kevFilter"
        type="text"
        placeholder="Filtrar por CVE, fabricante o producto…"
        class="w-full border border-rule-faint focus:border-ink px-4 py-2.5 text-sm text-ink placeholder-muted-dim focus:outline-none transition-colors duration-150 mb-6 font-mono"
      />

      <div id="kevList">
        {recentAdditions.length === 0 && (
          <div class="border border-rule-faint py-10 text-center text-sm text-muted">
            Sin novedades en los últimos 45 días.
          </div>
        )}
        <div class="table-scroll overflow-x-auto">
          <table class="w-full border-collapse font-mono text-sm min-w-[640px]">
            <thead>
              <tr class="border-b border-ink">
                <th class="text-left font-semibold text-[11px] uppercase tracking-wide text-muted py-3 pr-4">CVE</th>
                <th class="text-left font-semibold text-[11px] uppercase tracking-wide text-muted py-3 pr-4">Producto</th>
                <th class="text-left font-semibold text-[11px] uppercase tracking-wide text-muted py-3 pr-4">Vulnerabilidad</th>
                <th class="text-left font-semibold text-[11px] uppercase tracking-wide text-muted py-3">Plazo</th>
              </tr>
            </thead>
            <tbody>
              {recentAdditions.map((v: any) => (
                <tr class="kev-entry border-b border-rule-faint align-top" data-search={`${v.cveID} ${v.vendorProject} ${v.product}`.toLowerCase()}>
                  <td class="py-4 pr-4">
                    <a href={`https://nvd.nist.gov/vuln/detail/${v.cveID}`} target="_blank" rel="noopener noreferrer" class="font-semibold hover:text-stamp underline underline-offset-2">{v.cveID}</a>
                    <span class="block text-muted text-xs mt-1">{v.vendorProject}</span>
                  </td>
                  <td class="py-4 pr-4 text-ink-soft">{v.product}</td>
                  <td class="py-4 pr-4 text-ink-soft">
                    {v.vulnerabilityName}
                    {v.knownRansomware && (
                      <span class="inline-block ml-2 border border-stamp bg-stamp-tint text-stamp text-[10px] uppercase tracking-wide px-1.5 py-0.5 align-middle">Ransomware</span>
                    )}
                  </td>
                  <td class={`py-4 whitespace-nowrap ${v.dueDate && !isOverdue(v.dueDate) ? "text-stamp" : "text-muted"}`}>
                    {v.dueDate ? formatDate(v.dueDate) : "—"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <p class="font-mono text-xs text-muted mt-6">
        Fuente: CISA Known Exploited Vulnerabilities Catalog ·
        <a href="https://github.com/eduolihez/eduolihez.github.io/blob/main/scripts/update-kev.mjs" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-stamp ml-1">Ver el script de actualización →</a>
      </p>
    </section>

  </main>

  <Footer />
</Layout>

<script>
  const filterInput = document.getElementById('kevFilter') as HTMLInputElement;
  const entries = document.querySelectorAll<HTMLElement>('.kev-entry');

  filterInput?.addEventListener('input', () => {
    const q = filterInput.value.trim().toLowerCase();
    entries.forEach((el) => {
      const match = !q || (el.dataset.search || '').includes(q);
      el.classList.toggle('hidden', !match);
    });
  });
</script>

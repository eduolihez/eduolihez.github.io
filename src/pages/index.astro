---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Tools catalog
const tools = [
  {
    id: "defanger",
    title: "IOC Defanger & Extractor",
    description: "Desarma (defang) e higieniza de forma segura direcciones IP, URLs y correos electrónicos para tus informes, o extrae IOCs directamente desde texto crudo en segundos.",
    badge: "DISPONIBLE",
    badgeColor: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
    href: "/tools/defanger",
    actionText: "Abrir Herramienta",
    disabled: false,
  },
  {
    id: "email-analyzer",
    title: "Email Header Analyzer",
    description: "Analiza cabeceras crudas de correos sospechosos o ficheros .eml de forma visual. Comprueba la autenticación SPF, DKIM, DMARC y representa los saltos de red.",
    badge: "DISPONIBLE",
    badgeColor: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
    href: "/tools/email-analyzer",
    actionText: "Abrir Herramienta",
    disabled: false,
  },
  {
    id: "yara-generator",
    title: "Generador de Reglas YARA",
    description: "Escribe y valida reglas de detección YARA sin errores de sintaxis a través de un asistente paso a paso con analizador (linter) integrado en tiempo real.",
    badge: "DISPONIBLE",
    badgeColor: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
    href: "/tools/yara-generator",
    actionText: "Abrir Herramienta",
    disabled: false,
  },
  {
    id: "playbooks",
    title: "Playbooks Interactivos",
    description: "Árboles de decisión interactivos para diagnosticar incidentes de seguridad (Phishing, Malware, Fuerza Bruta) con recomendaciones y consultas SIEM automáticas.",
    badge: "DISPONIBLE",
    badgeColor: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
    href: "/tools/playbooks",
    actionText: "Abrir Herramienta",
    disabled: false,
  },
  {
    id: "decoder",
    title: "Payload Decoder & Deobfuscator",
    description: "Decodifica Base64 (UTF-8/UTF-16LE), URL, Hex y desofusca scripts de PowerShell limpiando concatenaciones y backticks de forma local.",
    badge: "DISPONIBLE",
    badgeColor: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
    href: "/tools/decoder",
    actionText: "Abrir Herramienta",
    disabled: false,
  },
  {
    id: "osint-hub",
    title: "OSINT Hub & Enlaces Externos",
    description: "Genera consultas rápidas OSINT extrayendo y vinculando IPs, dominios y hashes a motores externos (VirusTotal, AbuseIPDB) con directorio de recursos.",
    badge: "DISPONIBLE",
    badgeColor: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
    href: "/tools/osint-hub",
    actionText: "Abrir Herramienta",
    disabled: false,
  },
  {
    id: "passwdcentinel",
    title: "Password Sentinel",
    description: "Visita el proyecto oficial de tu extensión de Chrome para auditar contraseñas y verificar filtraciones vía API de Have I Been Pwned.",
    badge: "EXTENSION CHROME",
    badgeColor: "bg-amber-500/10 text-amber-400 border-amber-500/20",
    href: "https://eduolihez.com/projects/passwdcentinel/",
    actionText: "Ir a eduolihez.com",
    disabled: false,
    external: true,
  },
  {
    id: "followguard",
    title: "FollowGuard OSINT",
    description: "Visualiza el desarrollo de tu herramienta de ciberinteligencia en redes sociales para detectar perfiles falsos y bots.",
    badge: "PYTHON / GRAPH",
    badgeColor: "bg-purple-500/10 text-purple-400 border-purple-500/20",
    href: "https://eduolihez.com/projects/followguard/",
    actionText: "Ir a eduolihez.com",
    disabled: false,
    external: true,
  }
];
---

<Layout title="Blue Team Hub | Eduardo Olivares" description="Portal de herramientas estáticas de ciberseguridad para analistas SOC y respuesta a incidentes.">
  <Header activeTab="inicio" />
  
  <main class="w-full max-w-6xl mx-auto px-4 mt-16 flex-grow">
    
    <!-- Hero Section -->
    <section class="text-center relative py-12 md:py-20 overflow-hidden">
      <!-- Glow decoration -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 h-80 rounded-full bg-blue-500/5 blur-[90px] -z-10 pointer-events-none"></div>
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.03] border border-white/[0.08] text-[11px] font-medium text-neutral-400 mb-6 backdrop-blur-md">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        ESTADO: DESPLIEGUE ESTABLE (GITHUB PAGES)
      </div>
      
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white mb-6 leading-tight max-w-4xl mx-auto">
        Herramientas y Recursos para <br class="hidden md:inline" />
        <span class="bg-gradient-to-r from-blue-400 via-indigo-400 to-purple-400 bg-clip-text text-transparent">
          Operaciones de Seguridad (SOC)
        </span>
      </h1>
      
      <p class="text-sm md:text-base text-neutral-400 max-w-2xl mx-auto mb-10 leading-relaxed font-light">
        Un espacio de utilidades <strong class="font-normal text-neutral-200">100% estáticas y locales</strong> (sin envío de datos a servidores) diseñado para analistas SOC, investigadores de amenazas y operaciones del Blue Team.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#herramientas" class="w-full sm:w-auto">
          <button class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-white text-black hover:bg-neutral-200 font-semibold text-xs transition-all duration-200 cursor-pointer shadow-lg shadow-white/5">
            Ver Herramientas
          </button>
        </a>
        <a href="https://github.com/eduolihez" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto">
          <button class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.08] text-white font-semibold text-xs transition-all duration-200 cursor-pointer">
            Ver GitHub
          </button>
        </a>
      </div>
    </section>

    <!-- Grid Layout Tools Section -->
    <section id="herramientas" class="mt-20 scroll-mt-28">
      <div class="flex items-center justify-between mb-8 border-b border-white/[0.06] pb-4">
        <h2 class="text-lg md:text-xl font-bold text-white flex items-center gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5 text-blue-400">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 1 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766l.002-.001a3.005 3.005 0 0 0 1.883-1.882l.002-.006a2.89 2.89 0 0 0-.743-2.98l-.018-.018a2.89 2.89 0 0 0-2.98-.743l-.006.002a3.005 3.005 0 0 0-1.883 1.883l-.001.002a2.65 2.65 0 0 0-.766 1.209l-3.03 2.496M11.42 15.17l-1.52 1.52a2.652 2.652 0 1 1-3.75-3.75l1.52-1.52M9 9l.008-.008a3 3 0 0 1 4.243 4.243L13 13M9 9l-5.877-5.877a2.653 2.653 0 0 0-3.75 3.75L5.25 12.75M9 9l-3.03 2.496a2.65 2.65 0 0 0-.766 1.209l-1.52 1.52M13 13l2.496-3.03c.317-.384.74-.626 1.208-.766l.002-.001a3.005 3.005 0 0 0 1.883-1.882l.002-.006a2.89 2.89 0 0 0-.743-2.98l-.018-.018a2.89 2.89 0 0 0-2.98-.743l-.006.002a3.005 3.005 0 0 0-1.883 1.883l-.001.002a2.65 2.65 0 0 0-.766 1.209l-3.03 2.496" />
          </svg>
          Caja de Herramientas
        </h2>
        <span class="text-xs text-neutral-500 font-mono">
          Total: {tools.length} elementos
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {tools.map((tool) => (
          <div class={`relative group rounded-2xl transition-all duration-300 ${
            tool.disabled 
              ? 'opacity-60 cursor-not-allowed bg-black/20 border border-neutral-900' 
              : 'bg-black/30 hover:bg-white/[0.02] border border-white/[0.06] hover:border-white/12 hover:-translate-y-1 hover:shadow-xl hover:shadow-blue-500/5'
          }`}>
            <!-- Card content wrapper -->
            <div class="p-6 flex flex-col justify-between h-full min-h-[220px]">
              <div>
                <!-- Card Header -->
                <div class="flex items-center justify-between mb-5">
                  <div class="text-neutral-400 group-hover:text-blue-400 group-hover:scale-105 transition-all duration-300">
                    {tool.id === "defanger" && (
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6.5 h-6.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v1.244c0 .89.56 1.6 1.341 1.91l.81.32c.536.21.899.74.899 1.32v8.5c0 .779-.63 1.41-1.41 1.41h-2.78c-.78 0-1.41-.63-1.41-1.41v-8.5c0-.58.363-1.11.899-1.32l.81-.32c.78-.31 1.34-1.02 1.34-1.91V3.104m5.25 0v1.244c0 .89-.56 1.6-1.341 1.91l-.81.32c-.536.21-.899.74-.899 1.32v8.5c0 .779.63 1.41 1.41 1.41h2.78c.78 0 1.41-.63 1.41-1.41v-8.5c0-.58-.363-1.11-.899-1.32l-.81-.32c-.78-.31-1.34-1.02-1.34-1.91V3.104m-9 13.5h9" />
                      </svg>
                    )}
                    {tool.id === "email-analyzer" && (
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6.5 h-6.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                      </svg>
                    )}
                    {tool.id === "yara-generator" && (
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6.5 h-6.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.75h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                      </svg>
                    )}
                    {tool.id === "playbooks" && (
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6.5 h-6.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7.184 11.246A17.926 17.926 0 0 0 12 11.5a17.926 17.926 0 0 0 4.816-.254m-9.632 0A17.95 17.95 0 0 1 12 12c1.726 0 3.39-.244 4.816-.698m-9.632 0A18.022 18.022 0 0 1 3 19.5h18a18.022 18.022 0 0 1-4.816-8.198m-8.368 0a17.926 17.926 0 0 0 1.868-6.548M12 4.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm0 0a3 3 0 1 0 6 0 3 3 0 0 0-6 0Zm0 0a3 3 0 1 1 0 6 3 3 0 0 1 0-6Z" />
                      </svg>
                    )}
                    {tool.id === "decoder" && (
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6.5 h-6.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 9h7.5L9 20.25 10.5 15h-6.75z" />
                      </svg>
                    )}
                    {tool.id === "osint-hub" && (
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6.5 h-6.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918" />
                      </svg>
                    )}
                    {tool.id === "passwdcentinel" && (
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6.5 h-6.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
                      </svg>
                    )}
                    {tool.id === "followguard" && (
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6.5 h-6.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v5.25c0 .621-.504 1.125-1.125 1.125h-2.25A1.125 1.125 0 0 1 3 18.375v-5.25ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125v-9.75ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v14.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
                      </svg>
                    )}
                  </div>
                  <span class={`text-[9px] px-2 py-0.5 rounded-md border font-mono font-medium tracking-wider ${tool.badgeColor}`}>
                    {tool.badge}
                  </span>
                </div>

                <!-- Text -->
                <h3 class="text-base font-bold text-neutral-200 group-hover:text-white transition-colors duration-200 mb-2">
                  {tool.title}
                </h3>
                <p class="text-xs text-neutral-400 leading-relaxed font-light mb-6">
                  {tool.description}
                </p>
              </div>

              <!-- Action Link / Bottom -->
              <div class="mt-auto pt-4 border-t border-white/[0.04] flex items-center justify-between text-xs">
                {tool.disabled ? (
                  <span class="text-neutral-600 font-medium select-none flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-3.5 h-3.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                    </svg>
                    {tool.actionText}
                  </span>
                ) : (
                  <a 
                    href={tool.href} 
                    target={tool.external ? "_blank" : undefined}
                    rel={tool.external ? "noopener noreferrer" : undefined}
                    class="text-blue-400 group-hover:text-blue-300 font-medium flex items-center gap-1.5 transition-colors duration-200"
                  >
                    {tool.actionText}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform duration-200">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
            
            <!-- Glow Effect on Hover -->
            {!tool.disabled && (
              <div class="absolute inset-0 rounded-2xl bg-gradient-to-tr from-blue-500/0 via-blue-500/0 to-blue-500/[0.04] opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
            )}
          </div>
        ))}
      </div>
    </section>

  </main>
  
  <Footer />
</Layout>

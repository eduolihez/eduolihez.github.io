---
interface Props {
  activeTab?: 'inicio' | 'herramientas';
}

const { activeTab } = Astro.props;
---

<header class="w-full max-w-6xl mx-auto px-4 mt-6 sticky top-4 z-50">
  <div class="bg-neutral-900/60 backdrop-blur-md border border-white/5 rounded-2xl shadow-xl px-6 py-3.5 flex items-center justify-between transition-all duration-300">
    <!-- Brand/Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <span class="text-xl group-hover:scale-110 transition-transform duration-300">🛡️</span>
      <span class="font-extrabold text-lg tracking-tight bg-gradient-to-r from-blue-400 to-indigo-400 bg-clip-text text-transparent">
        Blue Team Hub
      </span>
    </a>

    <!-- Navigation -->
    <nav>
      <ul class="flex items-center gap-1 md:gap-2">
        <li>
          <a 
            href="/" 
            class={`px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium transition-all duration-200 ${
              activeTab === 'inicio' 
                ? 'bg-white/10 text-white border border-white/10' 
                : 'text-neutral-400 hover:text-white hover:bg-white/5 border border-transparent'
            }`}
          >
            Inicio
          </a>
        </li>
        <li>
          <a 
            href="/#herramientas" 
            class={`px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium transition-all duration-200 ${
              activeTab === 'herramientas' 
                ? 'bg-white/10 text-white border border-white/10' 
                : 'text-neutral-400 hover:text-white hover:bg-white/5 border border-transparent'
            }`}
          >
            Herramientas
          </a>
        </li>
        <li class="h-4 w-[1px] bg-neutral-800 mx-1"></li>
        <li>
          <a 
            href="https://eduolihez.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium text-neutral-400 hover:text-white hover:bg-white/5 border border-transparent transition-all duration-200 flex items-center gap-1"
          >
            Mi Wiki
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3 opacity-60">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

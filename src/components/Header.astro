---
interface Props {
  activeTab?: 'inicio' | 'herramientas';
}

const { activeTab } = Astro.props;
---

<header class="w-full border-b-2 border-ink">
  <div class="max-w-[1040px] mx-auto px-6 sm:px-7 h-16 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 min-w-0 group">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4.5 h-4.5 shrink-0">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.75h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
      </svg>
      <span class="font-bold text-sm sm:text-base tracking-tight whitespace-nowrap">
        Blue Team Hub
      </span>
    </a>

    <nav class="shrink-0">
      <ul class="flex items-center gap-1 sm:gap-2 font-mono text-[11px] sm:text-xs uppercase tracking-wide">
        <li>
          <a
            href="/"
            class={`px-2 sm:px-3 py-1.5 transition-colors duration-150 ${
              activeTab === 'inicio'
                ? 'text-ink underline underline-offset-4 decoration-2'
                : 'text-muted hover:text-ink'
            }`}
          >
            Inicio
          </a>
        </li>
        <li>
          <a
            href="/#herramientas"
            class={`px-2 sm:px-3 py-1.5 transition-colors duration-150 ${
              activeTab === 'herramientas'
                ? 'text-ink underline underline-offset-4 decoration-2'
                : 'text-muted hover:text-ink'
            }`}
          >
            Herramientas
          </a>
        </li>
        <li class="h-3.5 w-px bg-rule-faint mx-0.5"></li>
        <li>
          <a
            href="https://eduolihez.com"
            target="_blank"
            rel="noopener noreferrer"
            class="px-2 sm:px-3 py-1.5 text-muted hover:text-ink transition-colors duration-150 inline-flex items-center gap-1 whitespace-nowrap"
          >
            Portfolio
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3 opacity-70 shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

---
interface Tool {
  id: string;
  title: string;
  description: string;
  badge: string;
  badgeColor: string;
  href: string;
  actionText: string;
  disabled?: boolean;
  external?: boolean;
}

interface Props {
  tool: Tool;
  index: number;
  routeLabel?: string;
}

const { tool, index, routeLabel } = Astro.props;
const n = String(index).padStart(2, "0");
const label = routeLabel ?? (tool.external ? `${tool.href.replace(/^https?:\/\//, "")} ↗` : tool.href);
---

<li class={`grid grid-cols-[2.6em_minmax(0,1fr)_auto] items-baseline gap-5 py-4.5 border-b border-rule-faint ${tool.disabled ? "opacity-50" : ""}`}>
  <span class="font-mono text-sm text-muted pt-0.5">{n}</span>
  <div class="min-w-0">
    <h3 class="font-semibold text-[1.05rem] text-ink mb-1">
      {tool.title}
    </h3>
    <p class="text-sm text-muted max-w-[56ch]">
      {tool.description}
    </p>
  </div>
  {tool.disabled ? (
    <span class="font-mono text-xs text-muted whitespace-nowrap pt-0.5">{tool.badge}</span>
  ) : (
    <a
      href={tool.href}
      target={tool.external ? "_blank" : undefined}
      rel={tool.external ? "noopener noreferrer" : undefined}
      class="font-mono text-xs text-muted hover:text-stamp transition-colors duration-150 whitespace-nowrap pt-0.5"
    >
      {label}
    </a>
  )}
</li>

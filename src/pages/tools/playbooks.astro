  // UI state query selectors
  const selectorState = document.getElementById('selectorState') as HTMLDivElement;
  const wizardState = document.getElementById('wizardState') as HTMLDivElement;
  const resultsState = document.getElementById('resultsState') as HTMLDivElement;

  const btnCancelWizard = document.getElementById('btnCancelWizard') as HTMLButtonElement;

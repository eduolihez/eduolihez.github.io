  const btnSiemkql = document.getElementById('btnSiemkql') as HTMLButtonElement;
  const siemQueryOutput = document.getElementById('siemQueryOutput') as HTMLPreElement;
  const powershellOutput = document.getElementById('powershellOutput') as HTMLPreElement;

  // Incident Investigation Timer
  let timerInterval: any = null;
  let secondsElapsed = 0;
  const wizardTimer = document.getElementById('wizardTimer') as HTMLElement;
  const btnDownloadReport = document.getElementById('btnDownloadReport') as HTMLButtonElement;

  function startTimer() {
    stopTimer();
    secondsElapsed = 0;
    wizardTimer.textContent = "00:00";
    timerInterval = setInterval(() => {
      secondsElapsed++;
      const m = String(Math.floor(secondsElapsed / 60)).padStart(2, '0');
      const s = String(secondsElapsed % 60).padStart(2, '0');
      wizardTimer.textContent = `${m}:${s}`;
    }, 1000);
  }

  function stopTimer() {
    if (timerInterval) {
      clearInterval(timerInterval);
      timerInterval = null;
    }
  }

  // Set card selectors clicks
  document.querySelectorAll('.playbook-card').forEach((card) => {
    card.addEventListener('click', () => {
      const el = card as HTMLElement;
      const playbook = el.dataset.playbook || 'phishing';
      startPlaybook(playbook);
    });
  });

  function startPlaybook(name: string) {
    currentPlaybookName = name;
    currentStepId = 'start';
    historySteps = [];
    userAnswers = {};
    
    wizardIconPhishing.classList.add('hidden');
    wizardIconMalware.classList.add('hidden');
    wizardIconBruteforce.classList.add('hidden');
    
    if (name === 'phishing') {
      currentTree = phishingTree;
      wizardIconPhishing.classList.remove('hidden');
      wizardTitle.textContent = 'Playbook: Análisis de Phishing';
    } else if (name === 'malware') {
      currentTree = malwareTree;
      wizardIconMalware.classList.remove('hidden');
      wizardTitle.textContent = 'Playbook: Infección por Malware';
    } else {
      currentTree = bruteforceTree;
      wizardIconBruteforce.classList.remove('hidden');
      wizardTitle.textContent = 'Playbook: Fuerza Bruta SSH/RDP';
    }

    selectorState.classList.add('hidden');
    resultsState.classList.add('hidden');
    wizardState.classList.remove('hidden');

    startTimer();
    renderStep();
  }

  // Render question step
  function renderStep() {
    const step = currentTree[currentStepId];
    if (!step) return;

    // Check if it's a result step
    if (currentStepId.startsWith('R_')) {
      showResults(step as PlaybookResult);
      return;
    }

    const q = step as PlaybookQuestion;

    questionText.textContent = q.text;
    questionDesc.textContent = q.description;

    // Handle progress bar
    const totalEstSteps = 4;
    const currentStepNum = historySteps.length + 1;
    wizardStepText.textContent = `Paso ${currentStepNum} de ~${totalEstSteps}`;
    wizardProgress.style.width = `${(currentStepNum / totalEstSteps) * 100}%`;

    // Handle back button disabled
    btnWizardBack.disabled = historySteps.length === 0;

    // Handle dynamic variable inputs
    dynamicInputsWrapper.innerHTML = '';
    if (q.variableInput) {
      dynamicInputsWrapper.classList.remove('hidden');
      
      const v = q.variableInput;
      const wrap = document.createElement('div');
      wrap.className = 'flex flex-col gap-1.5';
      wrap.innerHTML = `
        <label for="${v.name}" class="text-xs text-neutral-400 font-medium">${v.label}</label>
        <input 
          type="text" 
          id="${v.name}" 
          value="${v.defaultValue}" 
          class="bg-neutral-950/60 border border-white/5 focus:border-blue-500/50 rounded-xl px-3 py-2 text-xs font-mono text-neutral-300 focus:outline-none"
          placeholder="${v.placeholder}"
        />
      `;
      dynamicInputsWrapper.appendChild(wrap);
    } else {
      dynamicInputsWrapper.classList.add('hidden');
    }

    // Render Options Buttons
    optionsContainer.innerHTML = '';
    q.options.forEach((opt) => {
      const btn = document.createElement('button');
      btn.className = 'px-4 py-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-neutral-200 hover:text-white font-semibold text-xs md:text-sm text-left transition-all duration-200 cursor-pointer active:scale-98 flex items-center justify-between group';
      btn.innerHTML = `
        <span>${opt.text}</span>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all duration-200">
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
      `;

      btn.addEventListener('click', () => {
        // Collect variables values before going to next step
        if (q.variableInput) {
          const val = (document.getElementById(q.variableInput.name) as HTMLInputElement).value.trim();
          userAnswers[q.variableInput.name] = val || q.variableInput.defaultValue;
        }

        historySteps.push(currentStepId);
        currentStepId = opt.nextId;
        renderStep();
      });

      optionsContainer.appendChild(btn);
    });
  }

  // Show Results State
  function showResults(res: PlaybookResult) {
    stopTimer();
    wizardState.classList.add('hidden');
    resultsState.classList.remove('hidden');

    // 1. Set Priority Badge
    let badgeColor = 'bg-blue-500/10 text-blue-400 border-blue-500/20';
    if (res.priority === 'Crítica') {
      badgeColor = 'bg-red-500/10 text-red-400 border-red-500/20';
    } else if (res.priority === 'Alta') {
      badgeColor = 'bg-amber-500/10 text-amber-400 border-amber-500/20';
    } else if (res.priority === 'Media') {
      badgeColor = 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20';
    }
    resultPriorityBadge.className = `inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold border mb-3 font-mono ${badgeColor}`;
    resultPriorityBadge.textContent = `PRIORIDAD ${res.priority.toUpperCase()}`;

    // 2. Set Playbook info header
    resultPlaybookInfo.textContent = `Playbook: ${currentPlaybookName.toUpperCase()} • ${historySteps.length} pasos analizados`;

    // 3. Set list remediations
    renderList(listContainment, res.containment);
    renderList(listEradication, res.eradication);
    renderList(listRecovery, res.recovery);

    // 4. Update SIEM and PowerShell Output
    updateSIEMOutput(res);
    powershellOutput.textContent = res.powershell(userAnswers);
  }

  function renderList(ulElement: HTMLUListElement, items: string[]) {
    ulElement.innerHTML = '';
    items.forEach((item) => {
      const li = document.createElement('li');
      // Simple parser to convert **bold** markdown to HTML <strong>
      li.innerHTML = item.replace(/\*\*(.*?)\*\*/g, '<strong class="font-semibold text-white">$1</strong>');
      ulElement.appendChild(li);
    });
  }

  function updateSIEMOutput(res: PlaybookResult) {
    if (activeSiem === 'spl') {
      btnSiemspl.className = 'px-2 py-1 rounded bg-blue-500/20 text-blue-300 text-[10px] font-bold font-mono transition-all border border-blue-500/30';
      btnSiemkql.className = 'px-2 py-1 rounded bg-white/5 text-neutral-400 text-[10px] font-bold font-mono transition-all border border-transparent hover:text-white';
      siemQueryOutput.textContent = res.spl(userAnswers);
    } else {
      btnSiemkql.className = 'px-2 py-1 rounded bg-blue-500/20 text-blue-300 text-[10px] font-bold font-mono transition-all border border-blue-500/30';
      btnSiemspl.className = 'px-2 py-1 rounded bg-white/5 text-neutral-400 text-[10px] font-bold font-mono transition-all border border-transparent hover:text-white';
      siemQueryOutput.textContent = res.kql(userAnswers);
    }
  }

  // SIEM tab toggles
  btnSiemspl.addEventListener('click', () => {
    activeSiem = 'spl';
    const res = currentTree[currentStepId] as PlaybookResult;
    if (res) updateSIEMOutput(res);
  });

  btnSiemkql.addEventListener('click', () => {
    activeSiem = 'kql';
    const res = currentTree[currentStepId] as PlaybookResult;
    if (res) updateSIEMOutput(res);
  });

  // Wizard Back Navigation
  btnWizardBack.addEventListener('click', () => {
    if (historySteps.length > 0) {
      currentStepId = historySteps.pop()!;
      renderStep();
    }
  });

  // Cancel Wizard
  btnCancelWizard.addEventListener('click', () => {
    resetPlaybook();
  });

  // Reset to initial state
  btnReset.addEventListener('click', () => {
    resetPlaybook();
  });

  function resetPlaybook() {
    stopTimer();
    wizardState.classList.add('hidden');
    resultsState.classList.add('hidden');
    selectorState.classList.remove('hidden');
    historySteps = [];
    currentStepId = '';
  }

  // Report Download Listener
  btnDownloadReport.addEventListener('click', () => {
    const res = currentTree[currentStepId] as PlaybookResult;
    if (!res) return;

    let md = `# Informe de Incidente SOC - Blue Team Hub\n\n`;
    md += `**Fecha del Informe:** ${new Date().toLocaleString()}\n`;
    md += `**Playbook Utilizado:** ${currentPlaybookName.toUpperCase()}\n`;
    md += `**Prioridad Asignada:** ${res.priority.toUpperCase()}\n`;
    md += `**Tiempo de Investigación:** ${wizardTimer.textContent}\n\n`;

    md += `## 1. Acciones de Contención\n`;
    res.containment.forEach(item => {
      md += `- ${item}\n`;
    });
    md += `\n`;

    md += `## 2. Acciones de Erradicación\n`;
    res.eradication.forEach(item => {
      md += `- ${item}\n`;
    });
    md += `\n`;

    md += `## 3. Acciones de Recuperación\n`;
    res.recovery.forEach(item => {
      md += `- ${item}\n`;
    });
    md += `\n`;

    md += `## 4. Comando de Remediación (PowerShell)\n`;
    md += `\`\`\`powershell\n${powershellOutput.textContent}\n\`\`\`\n\n`;

    md += `## 5. Consulta de Búsqueda SIEM (${activeSiem.toUpperCase()})\n`;
    md += `\`\`\`\n${siemQueryOutput.textContent}\n\`\`\`\n`;

    const blob = new Blob([md], { type: "text/markdown;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `informe_incidente_${currentPlaybookName}_${Date.now()}.md`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });
</script>
